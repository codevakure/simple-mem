# ============================================================================
# SimpleMem Environment Configuration
# ============================================================================
# Copy this file to .env and configure your settings
# NEVER commit .env to version control!
# ============================================================================

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level controls verbosity of output
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
#
# DEBUG:    All details - token counts, similarity scores, per-entry processing
#           Use for development and troubleshooting
# INFO:     High-level operations - windows processed, memories stored, timings
#           Recommended for production monitoring
# WARNING:  Recoverable issues - retries, fallbacks, high context usage
# ERROR:    Failures that impact functionality
# CRITICAL: System failures
LOG_LEVEL=INFO

# Optional: Log to file in addition to console
# LOG_FILE=/var/log/simplemem/app.log

# Enable colored console output (set to false for log aggregators like CloudWatch)
LOG_COLORS=true

# ============================================================================
# ENDPOINT SELECTION
# ============================================================================
# Choose your backend: 'openai' or 'bedrock'
# - openai: OpenAI-compatible API (OpenAI, Qwen DashScope, Azure, etc.)
# - bedrock: AWS Bedrock (Nova, Claude, Titan embeddings)
ENDPOINT=bedrock

# ============================================================================
# VECTOR STORE SELECTION
# ============================================================================
# Choose: 'lancedb' (local file-based) or 'pgvector' (PostgreSQL)
# - lancedb: Good for development, single-node deployments
# - pgvector: Recommended for production, multi-node, better filtering
VECTOR_STORE=pgvector

# ============================================================================
# AWS BEDROCK CONFIGURATION (when ENDPOINT=bedrock)
# ============================================================================

# AWS Credentials (or use IAM roles in production)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Bedrock LLM Model for memory extraction and conflict resolution
# Options:
#   - amazon.nova-micro-v1:0    (128K context, fastest, lowest cost) ⭐ RECOMMENDED
#   - amazon.nova-lite-v1:0     (300K context, fast, multimodal)
#   - amazon.nova-pro-v1:0      (300K context, best quality)
#   - anthropic.claude-3-5-sonnet-20241022-v2:0 (200K, high quality, higher cost)
BEDROCK_LLM_MODEL=amazon.nova-micro-v1:0

# Bedrock Embedding Model for vector search
# amazon.titan-embed-text-v2:0 supports dimensions: 256, 512, 1024
# Higher dimensions = better accuracy, more storage
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024

# ============================================================================
# OPENAI-COMPATIBLE API CONFIGURATION (when ENDPOINT=openai)
# ============================================================================

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Custom Base URL (optional - leave empty for OpenAI default)
# Examples:
#   - Qwen/Alibaba: https://dashscope.aliyuncs.com/compatible-mode/v1
#   - Azure OpenAI: https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
#   - Local server: http://localhost:8000/v1
OPENAI_BASE_URL=

# LLM Model name
LLM_MODEL=gpt-4.1-mini

# Local Embedding Model (SentenceTransformers) - used with OpenAI endpoint
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ============================================================================
# POSTGRESQL + PGVECTOR CONFIGURATION (when VECTOR_STORE=pgvector)
# ============================================================================

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=simplemem
POSTGRES_PASSWORD=simplemem_dev_password
POSTGRES_DB=simplemem_db

# Full connection string (auto-constructed if not set)
# DATABASE_URL=postgresql://simplemem:simplemem_dev_password@localhost:5432/simplemem_db

# Memory table name
MEMORY_TABLE_NAME=memory_entries

# LanceDB path (when VECTOR_STORE=lancedb)
LANCEDB_PATH=./lancedb_data

# ============================================================================
# LLM SETTINGS
# ============================================================================

# Maximum tokens for LLM response
MAX_TOKENS=4096

# Enable streaming responses (recommended for better UX)
USE_STREAMING=true

# Temperature for LLM (0.0-1.0, lower = more deterministic)
# Recommended: 0.1 for memory extraction (consistency is key)
LLM_TEMPERATURE=0.1

# Enable JSON format mode (helps prevent parsing failures)
# Note: Not all models support this
USE_JSON_FORMAT=false

# ============================================================================
# MEMORY BUILDING PARAMETERS (MemOS Paper Implementation)
# ============================================================================
# Reference: "MemOS: An Operating System for LLMs" - Section 3.1

# Number of dialogue turns per processing window
# The window is the unit of LLM processing for memory extraction
#
# Paper recommendation: 40 (20 user-assistant exchanges)
# Real-time agents: 8-12 recommended for lower latency
#
# Trade-offs:
#   - Larger window = Better context, more accurate extraction, higher latency
#   - Smaller window = Faster processing, may miss cross-turn context
#
# Token estimation (assuming 4 chars/token):
#   - 8 turns × ~500 chars/turn = ~1000 tokens input
#   - 12 turns × ~500 chars/turn = ~1500 tokens input
#   - 40 turns × ~500 chars/turn = ~5000 tokens input
#
# With Nova Micro's 128K context, even 40 turns is well within limits
WINDOW_SIZE=12

# Window overlap for context continuity between batches
# When processing in parallel, this ensures no context is lost at boundaries
OVERLAP_SIZE=2

# Session TTL in minutes (for real-time mode - cleanup idle sessions)
SESSION_TTL_MINUTES=30

# ============================================================================
# CONFLICT RESOLUTION (Mem0 Paper Implementation)
# ============================================================================
# Reference: "Building Production-Ready AI Agents with Scalable Long-Term Memory"
#
# When enabled, new facts are compared against existing memories and LLM
# decides whether to ADD, UPDATE, DELETE, or skip (NONE)

# Enable/disable conflict resolution
# - true: Mem0-style ADD/UPDATE/DELETE (better accuracy, more LLM calls)
# - false: Direct add (faster, may have duplicates/conflicts)
ENABLE_CONFLICT_RESOLUTION=true

# Similarity threshold for conflict detection (0.0-1.0)
# Facts with similarity >= this threshold are considered potential conflicts
# - 0.75: Good balance between catching conflicts and avoiding false positives
# - 0.85: More strict, only very similar entries trigger conflict check
# - 0.65: More aggressive, may cause more LLM calls
CONFLICT_SIMILARITY_THRESHOLD=0.75

# Number of existing memories to compare against for each new fact
# Searches the agent's full memory space and returns top-k most similar
#
# Trade-offs:
#   - Higher = More thorough conflict detection, more LLM processing time
#   - Lower = Faster, may miss conflicts with older memories
#
# Recommendations:
#   - 20-50: Typical agents with moderate memory
#   - 100+: Critical data accuracy requirements
#   - 200+: Very large memory stores where conflicts are common
CONFLICT_CHECK_TOP_K=50

# ============================================================================
# RETRIEVAL PARAMETERS
# ============================================================================

# Max entries returned by semantic search (vector similarity)
SEMANTIC_TOP_K=25

# Max entries returned by keyword search (BM25 matching)
KEYWORD_TOP_K=5

# Max entries returned by structured search (metadata filtering)
STRUCTURED_TOP_K=5

# ============================================================================
# RETRIEVAL MODE (MemOS Paper Implementation)
# ============================================================================
# Reference: "MemOS" - Section 3.2 Hierarchical Memory Retrieval

# Enable query decomposition (splits complex queries into sub-queries)
# - false: Fast mode, direct search (~150-200ms)
# - true: Deep mode, LLM decomposes query first (~2-3 seconds)
ENABLE_PLANNING=false

# Enable reflection loop (checks if retrieved context is sufficient)
# - false: Single-pass retrieval
# - true: LLM may request additional searches if context incomplete
ENABLE_REFLECTION=false

# Maximum reflection rounds (only used when ENABLE_REFLECTION=true)
MAX_REFLECTION_ROUNDS=2

# ============================================================================
# PARALLEL PROCESSING
# ============================================================================

# Enable parallel memory building for large batch imports
ENABLE_PARALLEL_PROCESSING=true
MAX_PARALLEL_WORKERS=8

# Enable parallel retrieval across semantic/keyword/structured searches
ENABLE_PARALLEL_RETRIEVAL=true
MAX_RETRIEVAL_WORKERS=4

# ============================================================================
# DOCKER / PGADMIN (optional)
# ============================================================================

# pgAdmin credentials (for docker-compose --profile tools)
PGADMIN_EMAIL=admin@simplemem.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
