# ============================================================================
# SimpleMem Environment Configuration
# ============================================================================
# Copy this file to .env and configure your settings
# NEVER commit .env to version control!
# ============================================================================

# ============================================================================
# ENDPOINT SELECTION
# ============================================================================
# Choose your backend: 'openai' or 'bedrock'
# - openai: OpenAI-compatible API (OpenAI, Qwen DashScope, Azure, etc.)
# - bedrock: AWS Bedrock (Nova, Claude, Titan embeddings)
ENDPOINT=bedrock

# ============================================================================
# VECTOR STORE SELECTION
# ============================================================================
# Choose: 'lancedb' or 'pgvector'
VECTOR_STORE=pgvector

# ============================================================================
# AWS BEDROCK CONFIGURATION (when ENDPOINT=bedrock)
# ============================================================================

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Bedrock LLM Model
# Options:
#   - amazon.nova-micro-v1:0    (fastest, lowest cost) ⭐ RECOMMENDED
#   - amazon.nova-lite-v1:0     (fast, multimodal)
#   - amazon.nova-pro-v1:0      (best quality)
#   - anthropic.claude-3-5-sonnet-20241022-v2:0 (high quality, higher cost)
BEDROCK_LLM_MODEL=amazon.nova-micro-v1:0

# Bedrock Embedding Model
# amazon.titan-embed-text-v2:0 supports dimensions: 256, 512, 1024
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024

# ============================================================================
# OPENAI-COMPATIBLE API CONFIGURATION (when ENDPOINT=openai)
# ============================================================================

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Custom Base URL (optional - leave empty for OpenAI default)
# Examples:
#   - Qwen/Alibaba: https://dashscope.aliyuncs.com/compatible-mode/v1
#   - Azure OpenAI: https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
#   - Local server: http://localhost:8000/v1
OPENAI_BASE_URL=

# LLM Model name
LLM_MODEL=gpt-4.1-mini

# Local Embedding Model (SentenceTransformers)
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ============================================================================
# POSTGRESQL + PGVECTOR CONFIGURATION (when VECTOR_STORE=pgvector)
# ============================================================================

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=simplemem
POSTGRES_PASSWORD=simplemem_dev_password
POSTGRES_DB=simplemem_db

# Full connection string (auto-constructed if not set)
# DATABASE_URL=postgresql://simplemem:simplemem_dev_password@localhost:5432/simplemem_db

# Memory table name
MEMORY_TABLE_NAME=memory_entries

# ============================================================================
# VECTOR STORE SELECTION
# ============================================================================
# Choose: 'pgvector' or 'lancedb'
VECTOR_STORE=pgvector

# LanceDB path (when VECTOR_STORE=lancedb)
LANCEDB_PATH=./lancedb_data

# ============================================================================
# LLM SETTINGS
# ============================================================================

# Maximum tokens for LLM response
MAX_TOKENS=4096

# Enable streaming responses
USE_STREAMING=true

# Temperature for LLM (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.1

# ============================================================================
# MEMORY BUILDING PARAMETERS
# ============================================================================

# Number of dialogues per processing window
WINDOW_SIZE=40

# Window overlap for context continuity
OVERLAP_SIZE=2

# ============================================================================
# RETRIEVAL PARAMETERS
# ============================================================================

# Max entries returned by semantic search
SEMANTIC_TOP_K=25

# Max entries returned by keyword search
KEYWORD_TOP_K=5

# Max entries returned by structured search
STRUCTURED_TOP_K=5

# ============================================================================
# PARALLEL PROCESSING
# ============================================================================

# Enable parallel memory building
ENABLE_PARALLEL_PROCESSING=true
MAX_PARALLEL_WORKERS=8

# Enable parallel retrieval
ENABLE_PARALLEL_RETRIEVAL=true
MAX_RETRIEVAL_WORKERS=4

# ============================================================================
# DOCKER / PGADMIN (optional)
# ============================================================================

# pgAdmin credentials (for docker-compose --profile tools)
PGADMIN_EMAIL=admin@simplemem.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
