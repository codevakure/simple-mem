"""
Configuration file - System parameters and LLM settings

IMPORTANT:
1. Copy this file to config.py
2. Configure your settings below
3. Never commit config.py to version control (it contains your API key)

Alternatively, use .env file for environment-based configuration.
"""
import os

# Load .env file if python-dotenv is installed
try:
    from dotenv import load_dotenv
    load_dotenv()
except ImportError:
    pass  # python-dotenv not installed, rely on system env vars

def _env(key: str, default=None, cast_type=str):
    """Helper to get env var with type casting"""
    value = os.getenv(key, default)
    if value is None:
        return default
    if cast_type == bool:
        return str(value).lower() in ('true', '1', 'yes', 'on')
    return cast_type(value) if value else default

# ============================================================================
# ENDPOINT SELECTION
# ============================================================================
# Choose your backend: 'openai' or 'bedrock'
# - openai: Uses OpenAI-compatible API (OpenAI, Qwen DashScope, Azure, etc.)
# - bedrock: Uses AWS Bedrock (Nova, Claude, Titan)
ENDPOINT = _env("ENDPOINT", "openai")

# ============================================================================
# VECTOR STORE SELECTION  
# ============================================================================
# Choose your vector database: 'lancedb' or 'pgvector'
VECTOR_STORE = _env("VECTOR_STORE", "lancedb")

# ============================================================================
# AWS BEDROCK CONFIGURATION (when ENDPOINT=bedrock)
# ============================================================================
AWS_ACCESS_KEY_ID = _env("AWS_ACCESS_KEY_ID")
AWS_SECRET_ACCESS_KEY = _env("AWS_SECRET_ACCESS_KEY")
AWS_REGION = _env("AWS_REGION", "us-east-1")

# Bedrock LLM Model Options:
#   - amazon.nova-micro-v1:0    (fastest, lowest cost) ⭐ RECOMMENDED
#   - amazon.nova-lite-v1:0     (fast, multimodal)
#   - amazon.nova-pro-v1:0      (best quality)
#   - anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_LLM_MODEL = _env("BEDROCK_LLM_MODEL", "amazon.nova-micro-v1:0")

# Bedrock Embedding Model
BEDROCK_EMBEDDING_MODEL = _env("BEDROCK_EMBEDDING_MODEL", "amazon.titan-embed-text-v2:0")

# ============================================================================
# OPENAI-COMPATIBLE API CONFIGURATION (when ENDPOINT=openai)
# ============================================================================

# OpenAI API Key (required for openai endpoint)
OPENAI_API_KEY = _env("OPENAI_API_KEY", "your-api-key-here")

# Custom OpenAI Base URL (optional)
# Examples:
#   - Qwen/Alibaba: "https://dashscope.aliyuncs.com/compatible-mode/v1"
#   - Azure OpenAI: "https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT"
#   - Local server: "http://localhost:8000/v1"
#   - OpenAI (default): None
OPENAI_BASE_URL = _env("OPENAI_BASE_URL", None)

# LLM Model name
LLM_MODEL = _env("LLM_MODEL", "gpt-4.1-mini")

# Embedding model (local SentenceTransformers)
EMBEDDING_MODEL = _env("EMBEDDING_MODEL", "Qwen/Qwen3-Embedding-0.6B")
EMBEDDING_DIMENSION = _env("EMBEDDING_DIMENSION", 1024, int)
EMBEDDING_CONTEXT_LENGTH = 32768


# ============================================================================
# Advanced LLM Features
# ============================================================================

# Enable deep thinking mode (for Qwen and compatible models)
ENABLE_THINKING = _env("ENABLE_THINKING", False, bool)

# Enable streaming responses
USE_STREAMING = _env("USE_STREAMING", True, bool)

# Enable JSON format mode

# Helps prevent parsing failures from extra text like ```json
USE_JSON_FORMAT = _env("USE_JSON_FORMAT", False, bool)

# Maximum tokens for LLM response
MAX_TOKENS = _env("MAX_TOKENS", 4096, int)


# ============================================================================
# Memory Building Parameters
# ============================================================================

# Number of dialogues per window
WINDOW_SIZE = _env("WINDOW_SIZE", 40, int)

# Window overlap size (for context continuity)
OVERLAP_SIZE = _env("OVERLAP_SIZE", 2, int)


# ============================================================================
# Retrieval Parameters
# ============================================================================

# Max entries returned by semantic search (vector similarity)
SEMANTIC_TOP_K = _env("SEMANTIC_TOP_K", 25, int)

# Max entries returned by keyword search (BM25 matching)
KEYWORD_TOP_K = _env("KEYWORD_TOP_K", 5, int)

# Max entries returned by structured search (metadata filtering)
STRUCTURED_TOP_K = _env("STRUCTURED_TOP_K", 5, int)


# ============================================================================
# Database Configuration
# ============================================================================

# LanceDB path (when VECTOR_STORE=lancedb)
LANCEDB_PATH = _env("LANCEDB_PATH", "./lancedb_data")

# PostgreSQL Configuration (when VECTOR_STORE=pgvector)
POSTGRES_HOST = _env("POSTGRES_HOST", "localhost")
POSTGRES_PORT = _env("POSTGRES_PORT", 5432, int)
POSTGRES_USER = _env("POSTGRES_USER", "simplemem")
POSTGRES_PASSWORD = _env("POSTGRES_PASSWORD", "simplemem_dev_password")
POSTGRES_DB = _env("POSTGRES_DB", "simplemem_db")
DATABASE_URL = _env("DATABASE_URL") or f"postgresql://{POSTGRES_USER}:{POSTGRES_PASSWORD}@{POSTGRES_HOST}:{POSTGRES_PORT}/{POSTGRES_DB}"

# Memory table name
MEMORY_TABLE_NAME = _env("MEMORY_TABLE_NAME", "memory_entries")


# ============================================================================
# Parallel Processing Configuration
# ============================================================================

# Memory Building Parallel Processing
ENABLE_PARALLEL_PROCESSING = _env("ENABLE_PARALLEL_PROCESSING", True, bool)
MAX_PARALLEL_WORKERS = _env("MAX_PARALLEL_WORKERS", 16, int)

# Retrieval Parallel Processing  
ENABLE_PARALLEL_RETRIEVAL = _env("ENABLE_PARALLEL_RETRIEVAL", True, bool)
MAX_RETRIEVAL_WORKERS = _env("MAX_RETRIEVAL_WORKERS", 8, int)

# Planning and Reflection Configuration
ENABLE_PLANNING = True
ENABLE_REFLECTION = True
MAX_REFLECTION_ROUNDS = 2


# ============================================================================
# LLM-as-Judge Configuration (not used yet)
# ============================================================================

# Judge LLM API Key (optional - if None, uses OPENAI_API_KEY)
JUDGE_API_KEY = "your api-key here"

# Judge LLM Base URL (optional - if None, uses OPENAI_BASE_URL)
# Example: Use cheaper endpoint for evaluation
JUDGE_BASE_URL = "https://api.openai.com/v1/"

# Judge LLM Model (optional - if None, uses LLM_MODEL)
JUDGE_MODEL = "gpt-4.1-mini"

# Judge specific settings
JUDGE_ENABLE_THINKING = False  # Usually false for evaluation tasks
JUDGE_USE_STREAMING = False    # Usually false for evaluation
JUDGE_TEMPERATURE = 0.3        

# Example configurations:
# 1. Use cheaper model for judge evaluation:
